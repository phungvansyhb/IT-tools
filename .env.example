# Optional: Site URL for canonical SEO tags, sitemap.xml, and OpenGraph metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Public GitHub repository URL shown in footer & Contact/About pages
NEXT_PUBLIC_GITHUB_URL=https://github.com/phungvansyhb/IT-tools

# Optional: Public support email shown on Contact page (leave empty to use the built-in Feedback modal only)
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional: Supabase Cloud Sync (leaves 100% functional via localStorage if omitted)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Cloudflare Web Analytics token for Manual JS Beacon (cookieless Pageviews & Core Web Vitals)
# Leave empty locally/self-hosted or when Cloudflare Automatic Setup is enabled to avoid double-injection.
NEXT_PUBLIC_CF_BEACON_TOKEN=
